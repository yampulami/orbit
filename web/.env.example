# Teammates: use the DEV Supabase project here (the owner sends the address and key). The live project's keys are never shared. See TEAM-WORKFLOW.md.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional, for alerts when Orbit is closed: the PUBLIC half of your VAPID key pair (see PUSH-SETUP.md). Never put the private key here.
VITE_VAPID_PUBLIC_KEY=
